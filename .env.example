# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/semanticauthoring_prod

# ── Site ─────────────────────────────────────────────────────────────────────
SITE_URL=https://semanticauthoring.org
SESSION_SECRET=

# ── God account seeding (first deploy only) ──────────────────────────────────
# The temporary password is supplied here at deploy time and NEVER committed.
# Both God accounts are forced to change it on first login.
SEED_GOD_TEMP_PASSWORD=

# ── R0cketShip Core API ──────────────────────────────────────────────────────
# Issue a key pair at the Core's /core-api (God only) with scopes:
#   lead:create, email:send
CORE_API_BASE=https://medigap.plus
CORE_API_KEY=
CORE_API_SECRET=

# ── Own SMTP (preferred for transactional mail) ──────────────────────────────
# When set, password resets and confirmations are sent directly as this domain
# rather than through the Core.
#
# BEFORE ENABLING, add these DNS records for semanticauthoring.org, or mail will
# be filtered as spam — an unauthenticated domain with no sending history is
# treated worse than a warmed third-party one:
#   SPF    TXT  @              "v=spf1 include:<your-provider> ~all"
#   DKIM   TXT  <selector>._domainkey   (value supplied by your provider)
#   DMARC  TXT  _dmarc         "v=DMARC1; p=none; rua=mailto:you@yourdomain"
# Start DMARC at p=none, watch the reports, then tighten to quarantine/reject.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Semantic Authoring <no-reply@semanticauthoring.org>

# ── Notifications ────────────────────────────────────────────────────────────
NOTIFY_TO=krystalore@thecrewscoach.com,jeff.cline@me.com

# ── Spam protection (Cloudflare Turnstile) ───────────────────────────────────
# Until these are set the public forms fall back to honeypot + rate limiting.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Visitor identification / tracking (public pages only, consent-gated) ─────
QUUIK_TRACKING_URL=https://quuik.com/api/pc.js
